# 시뮬레이터 설정. 필요하면 cp .env.example .env 후 수정 (모두 선택값)

# 위성 수 (기본 10)
SAT_COUNT=10
# 실제 시간 기준 발행 주기 ms (기본 1000)
INTERVAL_MS=1000
# 시뮬레이션 배속. 60이면 실제 1초 = 시뮬레이션 1분 (기본 60)
TIME_SCALE=60
# 위성·주기당 온도 급상승 이상 발생 확률 (기본 0.001)
ANOMALY_RATE=0.001
# MQTT 브로커 주소 (기본 mqtt://127.0.0.1:1883)
MQTT_URL=mqtt://127.0.0.1:1883
