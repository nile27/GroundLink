{
  "name": "groundlink",
  "private": true,
  "description": "GroundLink — 가상 위성 지상국 시스템",
  "workspaces": [
    "shared",
    "simulator",
    "server",
    "dashboard"
  ],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w simulator -w server",
    "start:server": "npm run start -w server",
    "start:sim": "npm run start -w simulator",
    "bench": "node bench/run.mjs",
    "dev:dashboard": "npm run dev -w dashboard",
    "build:dashboard": "npm run build -w dashboard",
    "build:profile": "npm run build:profile -w dashboard",
    "preview:profile": "npm run preview:profile -w dashboard"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
