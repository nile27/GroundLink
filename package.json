{
  "name": "groundlink",
  "private": true,
  "description": "GroundLink — 가상 위성 지상국 시스템",
  "workspaces": [
    "shared",
    "simulator",
    "server"
  ],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w simulator -w server",
    "start:server": "npm run start -w server",
    "start:sim": "npm run start -w simulator",
    "bench": "node bench/run.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
