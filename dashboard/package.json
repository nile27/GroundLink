{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:profile": "tsc -b && vite build --mode profile",
    "preview:profile": "vite preview --mode profile --port 5173 --strictPort",
    "gen:api": "npx -y openapi-typescript@7.13.0 http://127.0.0.1:3000/api/docs-json -o src/types/openapi.d.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxlint": "1.92.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
