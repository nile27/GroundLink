# 서버 전용 설정 (모두 선택값). DB 이름/사용자/비밀번호는 ../infra/.env 에서 읽음
# 이 파일을 .env 로 복사하면 같은 키는 infra/.env 보다 우선함

# HTTP 바인딩 (기본 127.0.0.1:3000). LAN의 WPF 클라이언트가 붙어야 하면 HOST=0.0.0.0
HOST=127.0.0.1
PORT=3000

MQTT_URL=mqtt://127.0.0.1:1883

DB_HOST=127.0.0.1
DB_PORT=5432
# 개발 중 엔티티 → 테이블 자동 동기화 (기본 true). 운영에서는 false + 마이그레이션
DB_SYNC=true
