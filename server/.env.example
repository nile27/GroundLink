# 서버 전용 설정 (모두 선택값). DB 이름/사용자/비밀번호는 ../infra/.env 에서 읽음
# 이 파일을 .env 로 복사하면 같은 키는 infra/.env 보다 우선함

# HTTP 바인딩 (기본 127.0.0.1:3000). LAN의 WPF 클라이언트가 붙어야 하면 HOST=0.0.0.0
HOST=127.0.0.1
PORT=3000

MQTT_URL=mqtt://127.0.0.1:1883

DB_HOST=127.0.0.1
DB_PORT=5432

# 명령 ack 대기 시간 (ms, 기본 10000). 넘으면 commands.status = TIMEOUT
COMMAND_TIMEOUT_MS=10000

# pg 커넥션 풀 크기 (기본 10, 3~90). 텔레메트리 동시 저장 수 = 풀 - 2 (나머지는 event·alarm·command·API용)
DB_POOL_SIZE=10

# 텔레메트리 일괄 저장: BATCH_SIZE건이 차거나 FLUSH_MS가 지나면 다중 행 INSERT 1건으로 저장
BATCH_SIZE=500
FLUSH_MS=200
# 역압: 저장 대기 버퍼 상한(행). 넘으면 OVERFLOW_POLICY에 따라 버리고 건수를 지표·로그에 남김
MAX_BUFFER=50000
# drop-oldest(기본: 오래된 것부터 버림) | drop-newest(새로 온 것을 버림)
OVERFLOW_POLICY=drop-oldest
